# Copy to .env and adjust as needed. Do not commit .env.

# Rails / PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quicktools_development
POSTGRES_HOST=postgres
POSTGRES_DB=quicktools_development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
FRONTEND_URL=http://localhost:5173
RAILS_ENV=development
SECRET_KEY_BASE=replace-with-output-of-backend-bin-rails-secret
RAILS_MASTER_KEY=

# Frontend (Vite). Production example:
# VITE_API_URL=https://YOUR-RAILS-RENDER-SERVICE.onrender.com
# VITE_SITE_URL=https://quicktoolsindia.com
VITE_API_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:5173
