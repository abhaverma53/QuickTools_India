#!/usr/bin/env bash
set -euo pipefail

rm -f /app/tmp/pids/server.pid

echo "Preparing database..."
for i in $(seq 1 30); do
  if bundle exec rails db:prepare; then
    exec "$@"
  fi
  echo "Database not ready, retrying (${i}/30)..."
  sleep 2
done

echo "Could not connect to the database."
exit 1
